# Valores falsos de ejemplo. Copia a .env (no se sube al repo) y ajusta.
NODE_ENV=development
PORT=3100
# Local: la API conecta como ga_app (puerto 5432 por defecto; usa 5433 si GA_DB_PORT=5433).
DATABASE_URL=postgres://ga_app:ga_app_local_falsa@localhost:5432/ga_dev
# En producción es obligatorio TLS verificado, p. ej.:
# DATABASE_URL=postgres://ga_app:<clave>@<host>:5432/<base>?sslmode=verify-full&sslrootcert=/ruta/al/bundle-ca.pem
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_EJEMPLO
COGNITO_CLIENT_ID=ejemploclientid0000000000
