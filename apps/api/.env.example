# Valores falsos de ejemplo. Copia a .env (no se sube al repo) y ajusta.
NODE_ENV=development
PORT=3100
# Local: la API conecta como ga_app (puerto 5432 por defecto; usa 5433 si GA_DB_PORT=5433).
DATABASE_URL=postgres://ga_app:ga_app_local_falsa@localhost:5432/ga_dev
# En producción es obligatorio TLS verificado, p. ej.:
# DATABASE_URL=postgres://ga_app:<clave>@<host>:5432/<base>?sslmode=verify-full&sslrootcert=/ruta/al/bundle-ca.pem
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_EJEMPLO
COGNITO_CLIENT_ID=ejemploclientid0000000000
# Cloudflare Turnstile (obligatorio en producción; sin él en desarrollo se usa un verificador falso).
# TURNSTILE_SECRET=
# Límite por IP de POST /api/v1/reservaciones.
RATE_LIMIT_RESERVAS_MAX=10
RATE_LIMIT_RESERVAS_VENTANA_MS=60000
# --- Proxy y captcha (ver apps/api/DESPLIEGUE.md) ---
# IP real del cliente. Por omisión false: X-Forwarded-For se IGNORA. Nunca "true".
# Un número = saltos de proxy de confianza (1 = solo el proxy que se conecta a la API; la API NO debe ser alcanzable
# más que por él) o una lista de IP/CIDR de proxies de confianza, p. ej. la red Docker de Caddy.
# TRUST_PROXY=172.18.0.0/16
# Hostnames que Turnstile debe devolver (obligatorio en producción), separados por comas.
# TURNSTILE_HOSTNAMES=www.ejemplo.com,ejemplo.com
# Versión del aviso de privacidad que se guarda con el consentimiento de promociones.
VERSION_AVISO_PRIVACIDAD=2026-11-24
