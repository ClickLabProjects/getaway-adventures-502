{
  "name": "getaway-adventures-reservas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @ga/web",
    "build": "npm run build -w @ga/web",
    "preview": "npm run preview -w @ga/web",
    "typecheck": "npm run typecheck -w @ga/web",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "make-admin": "node --env-file=.env scripts/make-admin.mjs",
    "db:seed": "node --env-file=.env scripts/migrate.mjs seed.sql",
    "db:admin": "node --env-file=.env scripts/migrate.mjs admin.sql",
    "db:i18n": "node --env-file=.env scripts/migrate.mjs i18n.sql"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
